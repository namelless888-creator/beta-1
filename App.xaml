<Application x:Class="Beta1.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Application.Resources>
<SolidColorBrush x:Key="Accent" Color="#54E0DA"/>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FAFAF7"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
<Style TargetType="Button"><Setter Property="Foreground" Value="#FAFAF7"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#35FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="Background" Value="#4068DAD4"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#24FFFFFF"/><Setter Property="BorderBrush" Value="#65FFFFFF"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="10,7"/><Setter Property="FontSize" Value="14"/></Style>
</Application.Resources></Application>
